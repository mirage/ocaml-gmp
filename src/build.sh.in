#!/bin/sh

set -e

xzcat gmp-6.3.0.tar.xz | tar -xf -
cd gmp-6.3.0
sed \
  -e 's/\(gmp_compile="$cc .*conftest.c\)/\1 $LIBS/g' \
  -e 's/\(gmp_compile="$CC .*conftest.c\)/\1 $LIBS/g' \
  configure > configure.tmp
mv configure.tmp configure

cc_maybe_gcc()
{
    $1 -dM -E - </dev/null | grep -Eq '^#define __GNUC__ ([4-9]$|[1-9][0-9]+$)'
}

cc_is_clang()
{
    $1 -dM -E - </dev/null | grep -Eq '^#define __clang__ 1$'
}

cc_is_gcc()
{
    cc_maybe_gcc $1 && ! cc_is_clang $1
}

cc_version=$($1 -dumpversion)
cc_major=$(echo "$cc_version" | cut -d '.' -f 1)
if [ -z "$cc_major" ]; then
    die "Impossible to recognize the version of cc: ${cc_version}"
fi
if cc_is_gcc $1; then
    if [ "$cc_major" -ge 15 ]; then
        patch -p1 configure ../gcc.15.patch
    fi
fi

chmod +x configure

if [ "$5" = "false" ]; then
    SHARED_LIBRARY_ARG="--disable-shared"
fi

# $1 => c_compiler
# $2 => host
# $3 => target
# $4 => ocamlc_cflags
# $5 => supports_shared_libraries
# $6 => native_c_libraries

# GMP names the 64-bit ABI differently on riscv64: its configure accepts only
# ABI=standard there, and errors on ABI=64 with
#   configure: error: ABI=64 is not among the following valid choices: standard
case "$3" in
  riscv64*) GMP_ABI=standard ;;
  *)        GMP_ABI=64 ;;
esac

ac_cv_func_obstack_vprintf=no \
ac_cv_func_localeconv=no \
./configure --host="$3" --build="$2" ABI="$GMP_ABI" CC="$1" CPPFLAGS="$4" LIBS="$6" $SHARED_LIBRARY_ARG

make SUBDIRS="mpn mpz mpq mpf"\
    -j%{jobs}% \
    PRINTF_OBJECTS= SCANF_OBJECTS= \
    CFLAGS+="-Werror=implicit-function-declaration" CPPFLAGS="$4"

cp gmp.h ..
cp .libs/libgmp.a ..
if [ "$5" = "true" ]; then
    # on OpenBSD the symlink libgmp.so does not exist by default for some reason
    libgmp=.libs/libgmp.so
    for f in .libs/libgmp.so.* ; do
      if ! test -L "$f" ; then
        libgmp=$f
        break
      fi
    done
    # depending on if the host is macos or not
    cp "$libgmp" ../dllgmp.so || cp .libs/libgmp.dylib ../dllgmp.so
else
    touch ../dllgmp.so
fi
